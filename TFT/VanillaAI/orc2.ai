//--------------------------------------------------------------------------------------------------
//  set_skills
//--------------------------------------------------------------------------------------------------
// fix 1.31 hero cannot Learning Skills
function SetHeroUint takes unit u, integer id returns unit
    local group g = CreateGroup()
    call GroupEnumUnitsOfPlayer(g, Player(GetAiPlayer()), null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        if GetUnitTypeId(u) == id and UnitAlive(u) and not IsUnitHidden(u) then
            call DestroyGroup(g)
            set g = null
            if id == hero_id then
                set b_hero1_done = true
            elseif id == hero_id2 then
                set b_hero2_done = true
            elseif id == hero_id3 then
                set b_hero3_done = true
            elseif id == hero_id4 then
                set b_hero4_done = true
            endif
            return u
        endif
        call GroupRemoveUnit(g, u )
    endloop
    call DestroyGroup(g)
    set g = null
    return u
endfunction

function SkillArraysfix takes nothing returns nothing
    local integer level = GetHeroLevelAI()
    local integer id = GetHeroId()
    local integer array sk
    local integer array up
    if level > max_hero_level then
        set max_hero_level = level
    endif

    if id == hero_id then
        set up[0] = 1
        set sk[1] = skills1[1]
        set sk[2] = skills1[2]
        set sk[3] = skills1[3]
        set sk[4] = skills1[4]
    elseif id == hero_id2 then
        set up[0] = 2
        set sk[1] = skills2[1]
        set sk[2] = skills2[2]
        set sk[3] = skills2[3]
        set sk[4] = skills2[4]
    elseif id == hero_id3 then
        set up[0] = 3
        set sk[1] = skills3[1]
        set sk[2] = skills3[2]
        set sk[3] = skills3[3]
        set sk[4] = skills3[4]
    else
        set up[0] = 4
        set sk[1] = skills4[1]
        set sk[2] = skills4[2]
        set sk[3] = skills4[3]
        set sk[4] = skills4[4]
    endif
    if fixskill_1[up[0]] then  // skill 2 and 3 low
        set up[1] = 1
    elseif fixskill_1_2[up[0]] then  // skill 3 low
        set up[1] = GetRandomInt(1, 2)
    else
        set up[1] = GetRandomInt(1, 3)
    endif
    if fixskill_1_2[up[0]] or GetRandomInt(0, 1) > 0 then
        if up[1] == 1 then
            set up[2] = 2
            set up[3] = 3
        elseif up[1] == 2 then
            set up[2] = 1
            set up[3] = 3
        else
            set up[2] = 1
            set up[3] = 2
        endif
    else
        if up[1] == 1 then
            set up[2] = 3
            set up[3] = 2
        elseif up[1] == 2 then
            set up[2] = 3
            set up[3] = 1
        else
            set up[2] = 2
            set up[3] = 1
        endif
    endif

    if herounit[up[0]] == null then
        set herounit[up[0]] = SetHeroUint(herounit[up[0]], id)
    endif
    if herounit[up[0]] != null and UnitAlive(herounit[up[0]]) then
        if level == 6 then
            call SelectHeroSkill(herounit[up[0]], sk[4])
        else
            call SelectHeroSkill(herounit[up[0]], sk[up[1]])
            call SelectHeroSkill(herounit[up[0]], sk[up[2]])
            call SelectHeroSkill(herounit[up[0]], sk[up[3]])
        endif
    endif
endfunction

function SetSkillArrayAtHero takes integer heroid, integer sikll1, integer sikll2, integer sikll3, integer sikll4, boolean fix_1_2, boolean fix_1 returns nothing
    if hero_id == heroid then
        set skills1[1] = sikll1
        set skills1[2] = sikll2
        set skills1[3] = sikll3
        set skills1[4] = sikll4
        set fixskill_1_2[1] = fix_1_2
        set fixskill_1[1] = fix_1
    elseif hero_id2 == heroid then
        set skills2[1] = sikll1
        set skills2[2] = sikll2
        set skills2[3] = sikll3
        set skills2[4] = sikll4
        set fixskill_1_2[2] = fix_1_2
        set fixskill_1[2] = fix_1
    elseif hero_id3 == heroid then
        set skills3[1] = sikll1
        set skills3[2] = sikll2
        set skills3[3] = sikll3
        set skills3[4] = sikll4
        set fixskill_1_2[3] = fix_1_2
        set fixskill_1[3] = fix_1
    elseif hero_id4 == heroid then
        set skills4[1] = sikll1
        set skills4[2] = sikll2
        set skills4[3] = sikll3
        set skills4[4] = sikll4
        set fixskill_1_2[4] = fix_1_2
        set fixskill_1[4] = fix_1
    endif
endfunction

function set_skills takes nothing returns nothing
    local integer i = hero_id
    if hero_id != BLADE_MASTER and hero_id2 != BLADE_MASTER and hero_id3 != BLADE_MASTER then
        set hero_id4 = BLADE_MASTER
    elseif hero_id != FAR_SEER and hero_id2 != FAR_SEER and hero_id3 != FAR_SEER then
        set hero_id4 = FAR_SEER
    elseif hero_id != TAUREN_CHIEF and hero_id2 != TAUREN_CHIEF and hero_id3 != TAUREN_CHIEF then
        set hero_id4 = TAUREN_CHIEF
    elseif hero_id != SHADOW_HUNTER and hero_id2 != SHADOW_HUNTER and hero_id3 != SHADOW_HUNTER then
        set hero_id4 = SHADOW_HUNTER
    endif
    if GetUnitCountDone(hero_id) > 0 then
        set i = -1
    elseif GetUnitCountDone(hero_id2) > 0 then  // check room open random
        set hero_id = hero_id2
        set hero_id2 = i
        set i = -1
    elseif GetUnitCountDone(hero_id3) > 0 then
        set hero_id = hero_id3
        set hero_id3 = i
        set i = -1
    elseif GetUnitCountDone(hero_id4) > 0 then
        set hero_id = hero_id4
        set hero_id4 = i
        set i = -1
    endif
    call SetSkillArrayAtHero(BLADE_MASTER, WIND_WALK, MIRROR_IMAGE, CRITICAL_STRIKE, BLADE_STORM, false, false)
    call SetSkillArrayAtHero(FAR_SEER, CHAIN_LIGHTNING, SPIRIT_WOLF, FAR_SIGHT, EARTHQUAKE, true, false)
    call SetSkillArrayAtHero(TAUREN_CHIEF, SHOCKWAVE, WAR_STOMP, ENDURANE_AURA, REINCARNATION, true, false)
    call SetSkillArrayAtHero(SHADOW_HUNTER, HEALING_WAVE, SERPENT_WARD, HEX, VOODOO, false, false)
    if i < 0 then
        set herounit[1] = SetHeroUint(herounit[1], hero_id)
        if herounit[1] != null then
            if fixskill_1[1] then  // skill 2 and 3 low
                call SelectHeroSkill(herounit[1], skills1[1])
            elseif fixskill_1_2[1] then  // skill 3 low
                call SelectHeroSkill(herounit[1], skills1[GetRandomInt(1, 2)])
            else
                call SelectHeroSkill(herounit[1], skills1[GetRandomInt(1, 3)])
            endif
        endif
    endif
endfunction

//--------------------------------------------------------------------------------------------------
//  setup_force
//--------------------------------------------------------------------------------------------------
function setup_force takes nothing returns nothing
    if (c_food_used < 22) or (basic_opening and GetGold() < 1200) then
        call AwaitMeleeHeroes()
    endif
    call InitMeleeGroup()

    call SetMeleeGroup( hero_id         )
    call SetMeleeGroup( hero_id2        )
    call SetMeleeGroup( hero_id3        )
    call SetMeleeGroup( GRUNT           )
    call SetMeleeGroup( RAIDER          )
    call SetMeleeGroup( TAUREN          )
    call SetMeleeGroup( HEAD_HUNTER     )
    call SetMeleeGroup( BERSERKER       )
    call SetMeleeGroup( WYVERN          )
    call SetMeleeGroup( WITCH_DOCTOR    )
    call SetMeleeGroup( SHAMAN          )
    call SetMeleeGroup( KODO_BEAST      )
    call SetMeleeGroup( BATRIDER        )
    call SetMeleeGroup( SPIRIT_WALKER   )
    call SetMeleeGroup( SPIRIT_WALKER_M )
    if GetUnitCountDone(hero_id4) > 0 then
        call SetMeleeGroup( hero_id4    )
    endif

    //elf
    call SetMeleeGroup( ARCHER          )
    call SetMeleeGroup( HUNTRESS        )
    call SetMeleeGroup( DRUID_TALON     )
    call SetMeleeGroup( DRUID_CLAW      )
    call SetMeleeGroup( DRYAD           )
    call SetMeleeGroup( CHIMAERA        )
    call SetMeleeGroup( MOUNTAIN_GIANT  )
    call SetMeleeGroup( FAERIE_DRAGON   )

    if GetUnitCountDone(HIPPO) > 0 then
        call SetMeleeGroup( HIPPO )
    endif

    if GetUnitCountDone(HIPPO_RIDER) > 0 then
        call SetMeleeGroup( HIPPO_RIDER )
    endif
    call SetMeleeGroup( DRUID_TALON_M   )
    call SetMeleeGroup( DRUID_CLAW_M    )

    //human
    call SetMeleeGroup( FOOTMEN         )
    call SetMeleeGroup( KNIGHT          )
    call SetMeleeGroup( RIFLEMEN        )
    call SetMeleeGroup( PRIEST          )
    call SetMeleeGroup( SORCERESS       )
    call SetMeleeGroup( GRYPHON         )
    call SetMeleeGroup( COPTER          )
    call SetMeleeGroup( SPELL_BREAKER   )
    call SetMeleeGroup( HUMAN_DRAGON_HAWK)

    //ud
    call SetMeleeGroup( GHOUL           )
    call SetMeleeGroup( CRYPT_FIEND     )
    call SetMeleeGroup( ABOMINATION     )
    call SetMeleeGroup( NECRO           )
    call SetMeleeGroup( BANSHEE         )
    call SetMeleeGroup( GARGOYLE        )
    call SetMeleeGroup( FROST_WYRM      )
    call SetMeleeGroup( OBS_STATUE      )
    if GetUnitCountDone(BLK_SPHINX) > 0 then
        call SetMeleeGroup( BLK_SPHINX  )
    endif
    call SetMeleeGroup( SHADE       )
    call SetInitialWave(10)
endfunction

//--------------------------------------------------------------------------------------------------
//  force_level
//--------------------------------------------------------------------------------------------------
function force_level takes nothing returns integer
    local integer level = 4
    set level = level + 2 * (c_hunter_done + c_raider_done + c_batrider_done + c_shaman_done + c_doc_done + c_swalker_done)
    set level = level + 3 * (c_grunt_done + c_kodo_done + c_wyvern_done)
    set level = level + 5 * (c_hero3_done + c_tauren_done)
    set level = level + 6 *  c_hero2_done
    return level
endfunction

//--------------------------------------------------------------------------------------------------
//  attack_sequence
//--------------------------------------------------------------------------------------------------
function attack_sequence takes nothing returns nothing
    local boolean needs_exp
    local boolean has_siege
    local boolean air_units
    local integer level

    loop
        exitwhen (not basic_opening and ((c_food_made - c_food_used < 15 and c_food_used > 22) or (c_hero1_done + c_hero2_done + c_hero3_done + c_hero4_done > 2))) or (basic_opening and c_hero1_done > 0 and c_grunt_done + c_hunter_done > 4)
        call Sleep(2)
    endloop

    if MeleeDifficulty() == MELEE_NEWBIE then
        call Sleep(240)
    endif

    call StaggerSleep(0,2)
    loop
        loop
            exitwhen not CaptainRetreating()
            call Sleep(2)
        endloop

        call setup_force()

        set level = force_level()
        set max_creeps = level * 4 / 5
        set min_creeps = max_creeps - 10
        if min_creeps < 0 then
            set min_creeps = 0
        endif

        set air_units        = c_wyvern_done > 0 or c_batrider_done > 0
        set needs_exp        = take_exp and (level >= 9 or c_gold_owned < 2000)
        set has_siege        = level >= 40 or 2*c_cat_done + c_raider_done + c_batrider_done >= 2
        set allow_air_creeps = c_wyvern_done + c_raider_done + c_hunter_done >= 3
        if has_siege then
            call SetMeleeGroup( ROCKET_TANK )
        endif

        call SingleMeleeAttack(needs_exp,has_siege,false,air_units)

        if MeleeDifficulty() == MELEE_NEWBIE then
            call Sleep(60)
        endif
    endloop
endfunction

//--------------------------------------------------------------------------------------------------
//  init_vars
//--------------------------------------------------------------------------------------------------
function init_vars takes nothing returns nothing

    if GetUpgradeLevel(UPG_ORC_BERSERKER) < 1 then
        set hunter_code = HEAD_HUNTER
    else
        set hunter_code = BERSERKER
    endif

    set b_ensnare           = b_ensnare or GetUpgradeLevel(UPG_ORC_ENSNARE) > 0

    set c_altar_done        = GetUnitCountDone(ORC_ALTAR)
    set c_barracks_done     = GetUnitCountDone(ORC_BARRACKS)
    set c_batrider          = GetUnitCount(BATRIDER)
    set c_batrider_done     = GetUnitCountDone(BATRIDER)
    set c_bestiary_done     = GetUnitCountDone(BESTIARY)
    set c_burrow            = GetUnitCount(BURROW)
    set c_burrow_done       = GetUnitCountDone(BURROW)
    set c_cat               = GetUnitCount(CATAPULT)
    set c_cat_done          = GetUnitCountDone(CATAPULT)
    set c_doc               = GetUnitCount(WITCH_DOCTOR)
    set c_doc_done          = GetUnitCountDone(WITCH_DOCTOR)
    set c_forge_done        = GetUnitCountDone(FORGE)
    set c_fortress_done     = TownCountDone(FORTRESS)
    set c_gold              = GetGold()
    set c_gold_owned        = GetGoldOwned()
    set c_great_hall        = TownCount(GREAT_HALL)
    set c_great_hall_done   = TownCountDone(GREAT_HALL)
    set c_grunt             = GetUnitCount(GRUNT)
    set c_grunt_done        = GetUnitCountDone(GRUNT)
    set c_hero1_done        = GetUnitCountDone(hero_id)
    set c_hero2_done        = GetUnitCountDone(hero_id2)
    set c_hero3_done        = GetUnitCountDone(hero_id3)
    set c_hero4_done        = GetUnitCountDone(hero_id4)
    set c_hunter_done       = TownCountDone(HEAD_HUNTER)
    set c_kodo              = GetUnitCount(KODO_BEAST)
    set c_kodo_done         = GetUnitCountDone(KODO_BEAST)
    set c_lodge_done        = GetUnitCountDone(LODGE)
    if HarvestFix then
        set c_mines         = 2
    else
        set c_mines         = GetMinesOwned()
    endif
    set c_peon_done         = GetUnitCountDone(PEON)
    set c_peon              = GetUnitCount(PEON)
    set c_raider            = GetUnitCount(RAIDER)
    set c_raider_done       = GetUnitCountDone(RAIDER)
    set c_shaman            = GetUnitCount(SHAMAN)
    set c_shaman_done       = GetUnitCountDone(SHAMAN)
    set c_stronghold_done   = TownCountDone(STRONGHOLD)
    set c_swalker           = TownCount(SPIRIT_WALKER)
    set c_swalker_done      = TownCountDone(SPIRIT_WALKER)
    set c_tauren            = GetUnitCount(TAUREN)
    set c_tauren_done       = GetUnitCountDone(TAUREN)
    set c_totem_done        = GetUnitCountDone(TOTEM)
    set c_voodoo_done       = GetUnitCountDone(VOODOO_LOUNGE)
    set c_wyvern            = GetUnitCount(WYVERN)
    set c_wyvern_done       = GetUnitCountDone(WYVERN)
    set c_zep               = GetUnitCount(ZEPPELIN)
    set c_food_made         = GetUnitCountDone(GREAT_HALL) * GetFoodMade(GREAT_HALL) + GetUnitCountDone(STRONGHOLD) * GetFoodMade(STRONGHOLD) + GetUnitCountDone(FORTRESS) * GetFoodMade(FORTRESS) + c_burrow_done * GetFoodMade(BURROW)
    set c_food_used         = FoodUsed()
    if c_food_made > c_food_max then
      set c_food_made = c_food_max
    endif

    if basic_opening and c_stronghold_done > 0 then
        set basic_opening = false
    endif
endfunction

//--------------------------------------------------------------------------------------------------
//  set_vars
//--------------------------------------------------------------------------------------------------
function set_vars takes nothing returns nothing
    loop
        call init_vars()
        call Sleep(1)
    endloop
endfunction

//--------------------------------------------------------------------------------------------------
//  buy_item
//--------------------------------------------------------------------------------------------------
function Distance_BetweenLoc_dk takes location locA, location locB returns real
  local real x = GetLocationX(locB) - GetLocationX(locA)
  local real y = GetLocationY(locB) - GetLocationY(locA)
  call RemoveLocation(locA)
  return SquareRoot(x * x + y * y)
endfunction

function SetShop takes nothing returns nothing
    local group g = CreateGroup()
    local unit u = null
    call GroupEnumUnitsOfPlayer(g, ai_player, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        if GetUnitTypeId(u) == 'ovln' and UnitAlive(u) and not IsUnitHidden(u) then
            set shop = u
            exitwhen true
        endif
        call GroupRemoveUnit(g, u)
    endloop
    call DestroyGroup(g)
    set g = null
    set u = null
endfunction

function Buy_Item takes integer item_id, boolean stack, boolean buyneed returns nothing
    local integer i = 1
    local integer c = 0
    local integer sum = 0
    local unit u = null
    local item t = null
    local location l = null
    if buyneed and c_gold > 800 and not TownThreatened() and not CaptainInCombat(false) and shop != null and UnitAlive(shop) then
        loop
            exitwhen i > 4
            if herounit[i] != null and UnitAlive(herounit[i]) then
                loop
                    exitwhen c > 5
                    set t = UnitItemInSlot(herounit[i], c)
                    if t == null then
                        set sum = sum + 1
                    elseif GetItemTypeId(t) == item_id then
                        if stack then
                            set sum = sum + 1
                        else
                            set sum = - 1
                            set c = 5
                        endif
                    endif
                    set c = c + 1
                endloop
                set c = 0
                if sum > 0 then
                    set u = herounit[i]
                    set i = 4
                endif
                set sum = 0
            endif
            set i = i + 1
        endloop
        if u != null then
            set l = GetUnitLoc(u)
            if Distance_BetweenLoc_dk(GetUnitLoc(shop), l) < 550 then
                call IssueTargetOrderById(shop, 'Aall', u)
                call Sleep(GetRandomInt(2,3))
                call IssueNeutralImmediateOrderById(ai_player, shop, item_id)
            endif
            call RemoveLocation(l)
            set l = null
            set u = null
        endif
        set t = null
    endif
endfunction

//--------------------------------------------------------------------------------------------------
//  do_upgrades
//--------------------------------------------------------------------------------------------------
function do_upgrades takes nothing returns nothing

    if c_forge_done >= 1 then
        if c_fortress_done >= 1 then
            call SetBuildUpgr( 3, UPG_ORC_MELEE     )
            call SetBuildUpgr( 3, UPG_ORC_RANGED    )
            call SetBuildUpgr( 3, UPG_ORC_ARMOR     )

        elseif c_stronghold_done >= 1 then
            call SetBuildUpgr( 2, UPG_ORC_MELEE     )
            call SetBuildUpgr( 2, UPG_ORC_RANGED    )
            call SetBuildUpgr( 2, UPG_ORC_ARMOR     )
        else
            call SetBuildUpgr( 1, UPG_ORC_MELEE     )
            call SetBuildUpgr( 1, UPG_ORC_RANGED    )
            call SetBuildUpgr( 1, UPG_ORC_ARMOR     )
        endif
    endif

    if c_bestiary_done >= 1 then
        if c_raider >= 1 then
            call SetBuildUpgr( 1, UPG_ORC_ENSNARE )
        endif

        if c_fortress_done >= 1 then
            if c_wyvern >= 1 then
                call SetBuildUpgr( 1, UPG_ORC_VENOM )
            endif

            if c_forge_done >= 1 and c_kodo >= 1 then
                call SetBuildUpgr( 1, UPG_ORC_WAR_DRUMS )
            endif

            if c_batrider >= 1 and c_voodoo_done > 0 then
                call SetBuildUpgr( 1, UPG_ORC_FIRE )
            endif
        endif
    endif

    if c_barracks_done >= 1 then
        if c_fortress_done >= 1 and c_grunt >= 2 then
            call SetBuildUpgr( 1, UPG_ORC_BERSERK   )
        endif

        if c_hunter_done >= 2 and c_forge_done >= 1 then
            call SetBuildUpgr( 1, UPG_ORC_BERSERKER )
        endif
        if c_stronghold_done >= 1 and c_hunter_done + c_doc_done + c_batrider_done > 2 then
            call SetBuildUpgr( 1, UPG_ORC_REGEN )
        endif
        if c_stronghold_done >= 1 and c_cat_done + c_batrider_done > 2 then
            call SetBuildUpgr( 1, UPG_ORC_NAPTHA )
        endif
    endif

    if c_lodge_done >= 1 then
        if c_fortress_done >= 1 then
            if c_shaman >= 1 then
                call SetBuildUpgr( 2, UPG_ORC_SHAMAN    )
            endif
            if c_doc >= 1 then
                call SetBuildUpgr( 2, UPG_ORC_DOCS      )
            endif
            if c_swalker >= 1 then
                call SetBuildUpgr( 2, UPG_ORC_SWALKER   )
            endif
        else
            if c_shaman >= 1 then
                call SetBuildUpgr( 1, UPG_ORC_SHAMAN    )
            endif
            if c_doc >= 1 then
                call SetBuildUpgr( 1, UPG_ORC_DOCS      )
            endif
            if c_swalker >= 1 then
                call SetBuildUpgr( 1, UPG_ORC_SWALKER   )
            endif
        endif
    endif
    if c_totem_done > 0 and c_swalker_done > 0 then
        if c_fortress_done >= 1 and GetUpgradeLevel(UPG_ORC_SWALKER) < 2 then
            call SetBuildUpgr( 2, UPG_ORC_SWALKER   )
        elseif GetUpgradeLevel(UPG_ORC_SWALKER) == 0 then
            call SetBuildUpgr( 1, UPG_ORC_SWALKER   )
        endif
    endif
    if c_totem_done >= 1 and c_tauren >= 1 then
        call SetBuildUpgr( 1, UPG_ORC_PULVERIZE )
    endif

    if c_great_hall_done >= 1 and c_raider + c_grunt_done >= 2 then
        call SetBuildUpgr( 1, UPG_ORC_PILLAGE )
    endif

    if c_forge_done >= 1 then
        if c_fortress_done >= 1 then
            call SetBuildUpgr( 3, UPG_ORC_SPIKES    )
            call SetBuildUpgr( 1, UPG_ORC_BURROWS   )
        elseif c_stronghold_done >= 1 then
            call SetBuildUpgr( 2, UPG_ORC_SPIKES    )
            if c_gold > 500 then
                call SetBuildUpgr( 1, UPG_ORC_BURROWS   )
            endif
        else
            call SetBuildUpgr( 1, UPG_ORC_SPIKES    )
        endif
    endif
endfunction

//--------------------------------------------------------------------------------------------------
//  build_sequence
//--------------------------------------------------------------------------------------------------
function build_hero_fix takes integer heronum, boolean herodone, integer heroid, integer num returns nothing
    local integer i = 0
    if heronum < 1 and c_altar_done > 0 then
      if herodone then  // resurrection no need wood, only can forcibly fix
        if herounit[num] != null and c_food_made - c_food_used >= 5 then
          set i = 133 + 42 * GetHeroLevel(herounit[num])  // buy hero gold 270 + 90 * GetHeroLevel(herounit[num])  wood 65 + 20 * GetHeroLevel(herounit[num])
          if c_gold >= i then
            set total_gold = Max(0, total_gold - i) // compensation
            call SetProduce(1,heroid,-1)
            return
          endif
        endif
        call SetBuildUnit(1, heroid)  // only can add sequence
      else  // build
        if num == 1 and c_food_made - c_food_used >= 5 then  // build first hero no need gold and wood -- just melee map , cannot custom map
          call SetProduce(1,heroid,-1)
          return
        endif
        call SetBuildUnit(1, heroid)  // only can add sequence
      endif
    endif
endfunction

function build_sequence takes nothing returns nothing
    local integer peons

    call InitBuildArray()

    if basic_opening then

        call MeleeTownHall( 0, GREAT_HALL )
        call MeleeTownHall( 1, GREAT_HALL )

        call SetBuildUnit(  2, PEON             )
        call SetBuildUnit(  1, ORC_ALTAR        )
        call SetBuildUnit(  5, PEON             )
        call SetBuildUnit(  1, ORC_BARRACKS     )
        call SetBuildUnit(  6, PEON             )
        call SetBuildUnit(  1, BURROW           )
        call SetBuildUnit(  8, PEON             )
        call SetBuildUnit(  1, GRUNT            )
        call build_hero_fix(GetUnitCount(hero_id), b_hero1_done, hero_id, 1)
        call SetBuildUnit(  9, PEON             )
        call SetBuildUnit(  2, BURROW           )
        call SetBuildUnit(  1, FORGE            )
        call SetBuildUnit(  2, GRUNT            )
        call SetBuildUnit( 11, PEON             )
        call SetBuildUnit(  3, BURROW           )
        if c_forge_done > 0 and c_barracks_done > 0 then
            call SetBuildUnit(  1, hunter_code      )
        endif
        call SetBuildUnit( 13, PEON             )
        call SetBuildUnit(  1, VOODOO_LOUNGE    )
        call SetBuildUnit(  3, GRUNT            )
        call SetBuildUnit( 15, PEON             )
        call SetBuildUnit(  1, STRONGHOLD       )
        call SetBuildUnit(  4, GRUNT            )
        if c_forge_done > 0 and c_barracks_done > 0 then
            call SetBuildUnit(  3, hunter_code      )
        endif 
        call BasicExpansion( c_mines < 2, GREAT_HALL )
        if c_stronghold_done > 0 and MeleeDifficulty() != MELEE_NEWBIE then
            call build_hero_fix(GetUnitCount(hero_id2), b_hero2_done, hero_id2, 2)
        endif
        if GetUnitCount(STRONGHOLD) > 0 and MeleeDifficulty() != MELEE_NEWBIE then
            call BuildFactory( ORC_BARRACKS    )
        endif
        if c_hero1_done > 0 and c_gold > 800 then
            if c_forge_done > 0 and c_barracks_done > 0 then
                call SetBuildNext(  6, hunter_code  )
            endif
            call SetBuildNext(  5, GRUNT       )
        endif
        if MeleeDifficulty() != MELEE_NEWBIE then
            call GuardSecondary( 1, 1, BURROW )
            call GuardSecondary( 1, 2, ORC_WATCH_TOWER )
        endif
        call GuardSecondary( 0, 2, ORC_WATCH_TOWER )
        call SetBuildUnit(  4, BURROW           )
        call SetBuildUnit(  6, GRUNT            )
        call SetBuildUnit(  5, BURROW           )
        if c_forge_done >= 1 and c_stronghold_done > 0 then
            call SetBuildUnit(  1, CATAPULT         )
        endif
        call SetBuildUpgr(  1, UPG_ORC_ARMOR    )
        call SetBuildUpgr(  1, UPG_ORC_MELEE   )
        call SetBuildUpgr(  2, UPG_ORC_RANGED   )
        call SetBuildUpgr(  1, UPG_ORC_SPIKES   )
        call SetBuildUpgr(  1, UPG_ORC_PILLAGE  )
        if c_forge_done >= 1 and c_stronghold_done > 0 then
            call SetBuildUnit(  2, CATAPULT         )
        endif
        return
    endif

    // need a peon or nothing will get built
    //
    if c_great_hall_done >= 1 then
        set peons = 6 - GetWood() / 200
        if peons < 3 then
            set peons = 3
        endif
        if c_mines < 2 or c_great_hall_done < 2 then
            set peons = peons + 5
        else
            set peons = peons + 10
        endif
        if peons > 15 then
            set peons = 15
        endif
        call SetBuildNext( peons, PEON )
    endif

    // need a great hall or we can't resource and make more peons
    //
    if c_great_hall < 1 and c_peon_done >= 1 then
        call MeleeTownHall( 0, GREAT_HALL )
        call MeleeTownHall( 1, GREAT_HALL )
        call MeleeTownHall( 2, GREAT_HALL )
    endif

    if c_gold > 500 and GetWood() < 100 then
        call SetBuildNext( 15, PEON )
    endif

    // get enough burrows to handle current food demand
    //
    if c_food_used + 6 >= c_food_made and c_food_made < c_food_max then
        call SetBuildUnit(  c_burrow_done + 1, BURROW )
    endif

    // if we have low gold in our mines then we need to expand
    //
    if c_gold_owned < 2000 or (c_gold < 500 and c_food_made - c_food_used < 10 and c_food_made > 40) then
        call BasicExpansion( c_mines < 2, GREAT_HALL )
        call GuardSecondary( 1, 1, BURROW )
        call GuardSecondary( 1, 2, ORC_WATCH_TOWER )
    endif

    // always rebuild heroes for defense
    //
    if c_altar_done >= 1 then
        if c_hero1_done > 0 then
            if c_hero2_done > 0 then
                if b_hero3_done or c_fortress_done >= 1 then
                    call build_hero_fix(GetUnitCount(hero_id3), b_hero3_done, hero_id3, 3)
                endif
                if b_hero4_done then
                    call build_hero_fix(GetUnitCount(hero_id4), b_hero4_done, hero_id4, 4)
                endif
            else
                call build_hero_fix(GetUnitCount(hero_id2), b_hero2_done, hero_id2, 2)
            endif
        else
            call build_hero_fix(GetUnitCount(hero_id), b_hero1_done, hero_id, 1)
        endif
    else
        call SetBuildUnit( 1, ORC_ALTAR )
    endif

    // minimum melee defense
    //
    if TownCount(STRONGHOLD) < 1 and GetUnitCountDone(GREAT_HALL) > 0 then
        call SetBuildUnit( 1, STRONGHOLD )
    endif
    call BuildFactory( ORC_BARRACKS  )

    if c_totem_done >= 1 and c_forge_done > 0 and c_fortress_done > 0 then
        call SetBuildUnit( 2, TAUREN        )
    endif
    if c_barracks_done > 0 then
        call SetBuildUnit( 3, GRUNT         )
    endif

    // minimum ranged/air defense and siege units
    //
    if c_bestiary_done >= 1 then
        if b_ensnare then
            call SetBuildUnit( 2, RAIDER )
        elseif c_barracks_done > 0 and c_forge_done >= 1 then
            call SetBuildUnit( 3, hunter_code   )
        endif
        call SetBuildUnit( 2, WYVERN )
        if c_voodoo_done >= 1 then
            call SetBuildUnit( 2, BATRIDER  )
        endif
        call SetBuildUnit( 3, RAIDER    )
    elseif c_barracks_done > 0 then
        if c_forge_done >= 1 then
            call SetBuildUnit( 3, hunter_code   )
            if c_stronghold_done > 0 then
                call SetBuildUnit( 2, CATAPULT      )
            endif
        endif
    endif

    call SetBuildUnit( 1, FORGE         )
    call SetBuildUnit( 1, VOODOO_LOUNGE )
    if c_stronghold_done > 0 then
        call SetBuildUnit( 1, LODGE         )
        call SetBuildUnit( 1, BESTIARY      )
    endif
    if b_hero2_done and GetUnitCountDone(STRONGHOLD) > 0 and GetUnitCount(FORTRESS) < 1 then
      call SetBuildUnit( 1, FORTRESS      )
    endif
    if c_fortress_done > 1 then
        call SetBuildUnit( 1, TOTEM         )
    endif

    // if we have a lot of gold then advance the tech tree
    //
    if c_gold > 1000 then

        call GuardSecondary( 1, 1, ORC_WATCH_TOWER  )
        call GuardSecondary( 1, 1, BURROW           )
        call GuardSecondary( 1, 2, ORC_WATCH_TOWER  )

        //call SetBuildUnit( 1, STRONGHOLD    )

        call do_upgrades()

        if c_gold > 2000 then
            call BuildFactory( ORC_BARRACKS )
            call BuildFactory( LODGE        )
            call BuildFactory( BESTIARY     )
            call BuildFactory( TOTEM        )
        endif

    elseif c_food_used >= UPKEEP_TIER1 then
        call do_upgrades()
    endif
    call BasicExpansion( c_mines < 2, GREAT_HALL )
    if c_great_hall_done > 1 then
        call GuardSecondary( 1, 2, ORC_WATCH_TOWER )
        call GuardSecondary( 1, 1, VOODOO_LOUNGE    )
        call GuardSecondary( 1, 1, BURROW )
    endif
    if c_food_used >= UPKEEP_TIER2 - 10 and c_gold < 2000 then
        return
    endif

    // full up with more troops in general
    //
    if c_totem_done >= 1 and c_forge_done > 0 and c_fortress_done > 0 then
        call SetBuildUnit( 4, TAUREN    )
    elseif c_barracks_done > 0 then
        call SetBuildUnit( 6, GRUNT     )
    endif

    if c_bestiary_done >= 1 then
        if b_ensnare then
            call SetBuildUnit( 4, RAIDER )
        endif
        call SetBuildUnit( 3, WYVERN )
        if c_forge_done >= 1 then
            call SetBuildUnit( 1, KODO_BEAST )
        endif
    endif

    if c_lodge_done >= 1 then
        call SetBuildUnit( 1, SHAMAN        )
        call SetBuildUnit( 1, WITCH_DOCTOR  )
        call SetBuildUnit( 1, SPIRIT_WALKER )
        call SetBuildNext( 4, SHAMAN        )
        call SetBuildNext( 1, WITCH_DOCTOR  )
        call SetBuildNext( 1, SPIRIT_WALKER )
    endif

    if c_gold_owned < 10000 then
        call BasicExpansion( c_mines < 3, GREAT_HALL )
        call GuardSecondary( 2, 1, BURROW )
        call GuardSecondary( 2, 2, ORC_WATCH_TOWER )
    endif

    if c_food_used >= 60 and c_zep < 3 then
        call GetZeppelin()
    endif
    if c_food_made > 100 and c_food_made - c_food_used < 4 then  // can build more food
        call SetBuildUnit( c_burrow + 1, BURROW )
    endif
    if c_voodoo_done > 0 and (shop == null or not UnitAlive(shop)) then
        call SetShop()
    endif
endfunction

//--------------------------------------------------------------------------------------------------
//  peon_assignment
//--------------------------------------------------------------------------------------------------
function InitMineCheck takes nothing returns nothing
  local group g = CreateGroup()
  local unit u = null
  local integer c = 0
  local integer n = 0
  local integer p = 1
  call GroupEnumUnitsInRangeOfLoc(g, homeloc, 1800, null)
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    if UnitAlive(u) and not IsUnitHidden(u) then  // fix home_location mine
      set n = 0
      if GetUnitTypeId(u) == 'ngol' and GetResourceAmount(u) > 0 then
        if c > 0 and town_mine == null then
          set town_mine = u
        endif
        set c = c + 1
      elseif (GetUnitTypeId(u) == 'egol' or GetUnitTypeId(u) == 'ugol') and GetResourceAmount(u) > 0 then
        set n = 1
      endif
      if GetOwningPlayer(u) != Player(GetAiPlayer()) and (IsUnitType(u, UNIT_TYPE_TOWNHALL) or n == 1) then
        set p = p + 1  // have more player , need fix harvest , but maybe no need fix expensive
      endif
    endif
    call GroupRemoveUnit(g, u)
  endloop
  set HarvestFix = c > p
  call DestroyGroup(g)
  set g = null
  call ClearHarvestAI()
  call HarvestGold(0,3)
  call HarvestWood(0,2)  // Early triggering Harvest
endfunction

function HarvestMineFix takes unit mine returns nothing
  local group g = CreateGroup()
  local unit u = null
  local integer i = 0
  local integer delaypeon = 2
  call GroupEnumUnitsInRangeOfLoc(g, homeloc, 1800, null)
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null or i >= delaypeon
    if UnitAlive(u) and IsUnitType(u, UNIT_TYPE_PEON) and not IsUnitHidden(u) and GetOwningPlayer(u) == ai_player then
      if GetUnitCurrentOrder(u) == 0 or GetUnitCurrentOrder(u) == OrderId("harvest") then  // no get other order peon , maybe the peon go buy unit or build some
        call IssueTargetOrder(u, "harvest", mine)
        set i = i + 1
      endif
    endif
    call GroupRemoveUnit(g, u)
  endloop
  call DestroyGroup(g)
  set g = null
  set u = null
endfunction

function MineCheck takes nothing returns nothing
    local group g = CreateGroup()
    local unit u = null
    local player p = null
    local boolean array b
    local integer i = 0
    local integer c = 0
    call GroupEnumUnitsInRangeOfLoc(g, homeloc, 2200, null)
    loop
      set u = FirstOfGroup(g)
      exitwhen u == null
      if GetResourceAmount(u) > 0 and UnitAlive(u) and not IsUnitHidden(u) then
        if GetUnitTypeId(u) == 'ngol' and (town_mine == null or GetResourceAmount(town_mine) <= 0) then  // find mine
          set town_mine = u
        endif
        set i = i + 1
      else
        set p = GetOwningPlayer(u)
        if IsPlayerEnemy(p, ai_player) and not b[GetPlayerId(p)] then
          set b[GetPlayerId(p)] = true
          set c = c + 1
        endif
      endif
      call GroupRemoveUnit(g, u)
    endloop
    call DestroyGroup(g)
    set g = null
    set HarvestFix = i > 0  // home_location no mine
    if c < i and HarvestFix and town_mine != null and GetResourceAmount(town_mine) > 0 and c_peon_done > 11 then
      call HarvestMineFix(town_mine)
    endif
    set p = null
endfunction

function InitLaboratory takes nothing returns nothing
    local group g = CreateGroup()
    local unit u = null
    local integer i = 0
    if GetPlayerController(Player(12)) == MAP_CONTROL_CREEP then
      call GroupEnumUnitsOfPlayer(g, Player(15), null)
    else
      call GroupEnumUnitsOfPlayer(g, Player(27), null)
    endif
    loop
      set u = FirstOfGroup(g)
      exitwhen u == null
      if GetUnitTypeId(u) == 'ngad' and UnitAlive(u) and not IsUnitHidden(u) then
        set laboratory[i] = u
        set i = i + 1
      endif
      call GroupRemoveUnit(g, u)
    endloop
    call DestroyGroup(g)
    set g = null
endfunction

function BuyShredder takes integer c returns nothing
    local integer i = 0
    if GetWood() < 600 and GetWood() > 200 and c_gold > 800 and c_food_made - c_food_used > 5 and GetUnitCountDone('ngir') < 1 and c > GetRandomInt(0, 4) then
      loop
        exitwhen laboratory[i] == null or GetUnitCountDone('ngir') > 0
        if IsVisibleToPlayer(GetUnitX(laboratory[i]), GetUnitY(laboratory[i]), ai_player) then
            call IssueNeutralImmediateOrderById(ai_player, laboratory[i], 'ngir')
        endif
        set i = i + 1
      endloop
    endif
endfunction

function peon_assignment takes nothing returns nothing
    local integer T
    local integer c = 0
    call InitMineCheck()  // if home_location distance 1500 have more mine , ELF and UD cannot harvest (old war3 version distance need 2200+ ), this can fix
    loop
        call ClearHarvestAI()

        set T = TownWithMine()
        call HarvestGold(T,4)
        call HarvestWood(0,1)
        call HarvestGold(T,1)
        call HarvestWood(0,1)
        if HarvestFix and c == 0 then
            call MineCheck()
        endif
        set c = c + 1
        if c > 6 then
            set c = 0
        endif
        if c_great_hall_done > 1 and c_mines > 1 then
            call HarvestGold(T+1,5)
        endif

        call HarvestWood(0,10)

        call build_sequence()
        call BuyShredder(c)
        call Sleep(GetRandomInt(1,3))
    endloop
endfunction

//--------------------------------------------------------------------------------------------------
//	main
//--------------------------------------------------------------------------------------------------
function main takes nothing returns nothing
    call PickMeleeHero(RACE_ORC)
    call set_skills()
    call InitLaboratory()
    call StandardAI(function SkillArraysfix, function peon_assignment, function attack_sequence)
    call StartThread(function set_vars)
    call PlayGame()
endfunction
